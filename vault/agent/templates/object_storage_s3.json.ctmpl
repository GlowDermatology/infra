{{- /* SeaweedFS identities file (-s3.config). admin = the object-storage pair; app = the S3_ACCESS_KEY_ID /
       S3_SECRET_ACCESS_KEY pair the backend uses, limited to the stack bucket; anonymous = unauthenticated GET
       of that bucket (how media is served without signed URLs). Values go through toJSON.
       No `with`/`if` around the secrets: a missing path must fail the render (nil .Data), never write an
       empty identities file (SeaweedFS could treat that as open access). */ -}}
{{- $env := env "GLOWDERMA_ENV" -}}
{{- $admin := secret (printf "secret/data/%s/object-storage" $env) -}}
{{- $s3 := secret (printf "secret/data/%s/s3" $env) -}}
{
  "identities": [
    {
      "name": "admin",
      "credentials": [{"accessKey": {{ $admin.Data.data.OBJECT_STORAGE_ADMIN_ACCESS_KEY_ID | toJSON }}, "secretKey": {{ $admin.Data.data.OBJECT_STORAGE_ADMIN_SECRET_ACCESS_KEY | toJSON }}}],
      "actions": ["Admin", "Read", "Write", "List", "Tagging"]
    },
    {
      "name": "app",
      "credentials": [{"accessKey": {{ $s3.Data.data.S3_ACCESS_KEY_ID | toJSON }}, "secretKey": {{ $s3.Data.data.S3_SECRET_ACCESS_KEY | toJSON }}}],
      "actions": ["Read:glowderma-media", "Write:glowderma-media", "List:glowderma-media", "Tagging:glowderma-media"]
    },
    {
      "name": "anonymous",
      "actions": ["Read:glowderma-media"]
    }
  ]
}
