# staging: public runtime settings of the Next.js server. Secrets (revalidate secret, internal API secret) come
# from Vault through vault-agent-frontend. Build-time values (site URL, allowed origins, media hosts) are baked
# into the image by the frontend pipeline from the frontend repo's variables STAGING_*.
GLOWDERMA_DATA_SOURCE=api
GLOWDERMA_COOKIE_SECURE=true

# Staff social sign-in: providers to offer (google,facebook) and public client ids (not secrets).
GLOWDERMA_OAUTH_PROVIDERS=
# live once Django has OAUTH_MODE=live (environments/<env>/backend.env); unset = providers disabled.
GLOWDERMA_OAUTH_MODE=
GLOWDERMA_GOOGLE_CLIENT_ID=
GLOWDERMA_FACEBOOK_APP_ID=

# Storefront social sign-in (public ids; a provider without its id gets no button).
GLOWDERMA_SHOP_GOOGLE_CLIENT_ID=
GLOWDERMA_SHOP_FACEBOOK_APP_ID=
GLOWDERMA_SHOP_APPLE_SERVICES_ID=
GLOWDERMA_SHOP_APPLE_REDIRECT_URI=
