# production: public Django settings for every backend process (api, worker, beat, migrate).
# NEVER put a secret here (this repository is public): secrets live in Vault at secret/production/django.
# Topology settings (hosts, networks, URLs derived from SITE_DOMAIN) are set in compose/app.yaml.
ALERT_ENV=production
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=4
DB_POOL=true

# Every provider fake until its go-live checklist is done (backend docs/integrations/*.md); then set
# <PROVIDER>_MODE=live here and its credentials in Vault.
INTEGRATIONS_MODE=fake
EMAIL_MODE=fake
OAUTH_MODE=fake

# The ops console (Django admin at OPS_DOMAIN/django-admin/). true needs OPS_ALLOWED_IPS in local.env.
DJANGO_ADMIN_ENABLED=false

# HSTS on Django responses (Caddy already sends one year). Preload is a deliberate, near-irreversible opt-in.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=false

EMAIL_FROM=no-reply@glowderma.uz
