# production: values for compose/app.yaml and compose/vault.yaml (scripts/deploy.sh passes this file to Compose).
# Public values only: this repository is public. Secrets are in Vault, private-but-not-secret values (office
# IP allow-list, backup remote) in /opt/glowderma/runtime/local.env on the server.
GLOWDERMA_ENV=production

# One origin: https://SITE_DOMAIN/ is Next.js, https://SITE_DOMAIN/api/v1/ is Django. DNS: A + AAAA records for
# SITE_DOMAIN, www.SITE_DOMAIN and OPS_DOMAIN pointing at this environment's server.
SITE_DOMAIN=glowderma.uz
# Django ops console (/django-admin/), reachable only from OPS_ALLOWED_IPS (local.env).
OPS_DOMAIN=ops.glowderma.uz
ACME_EMAIL=ops@glowderma.uz

# Memory limits sized for a 2 vCPU / 4 GB host.
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g
FRONTEND_MEM_LIMIT=768m
REDIS_MAXMEMORY=256mb

# Media storage. OBJECT_STORAGE_ENABLED pulls/runs SeaweedFS; USE_S3 makes Django store media in S3 (either can be off).
# Provider, bucket, endpoint and keys are in Vault: secret/<env>/s3 (change + scripts/restart.sh <env> backend).
OBJECT_STORAGE_ENABLED=false
USE_S3=false
S3_LOCATION=media
